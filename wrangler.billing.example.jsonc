// Copy to an untracked staging configuration after provisioning a separate test DB.
// Do not put secret values here. Use Cloudflare encrypted secrets / Secrets Store.
{
  "name": "football-analyzer-billing-test",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-11-05",
  "dev": { "ip": "localhost", "port": 8787, "local_protocol": "https" },
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/api/*"], "not_found_handling": "single-page-application" },
  "vars": {
    "BILLING_ENABLED": "false",
    "BILLING_ENV": "test",
    "APP_ORIGIN": "https://REPLACE_WITH_TEST_HOST",
    "OIDC_ISSUER": "https://REPLACE_WITH_IDENTITY_ISSUER",
    "OIDC_CLIENT_ID": "REPLACE_WITH_IDENTITY_CLIENT_ID",
    "STRIPE_PRICE_ID": "price_1UZWqYJXx4e152C0iVacePXS",
    "STRIPE_PORTAL_CONFIGURATION_ID": "bpc_1UZWrzJXx4e152C0KFLF4U0A"
  },
  "d1_databases": [{ "binding": "BILLING_DB", "database_name": "football-analyzer-billing-test", "database_id": "REPLACE_WITH_TEST_DATABASE_ID" }],
  "triggers": { "crons": ["15 * * * *"] }
}
